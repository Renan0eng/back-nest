# Database
DATABASE_URL="postgresql://user:password@localhost:5432/db_name"
MONGODB_URL="mongodb://user:password@localhost:27017"
MONGODB_DATABASE="prefeitura"
PUBLIC_API_URL="http://localhost:4000"

# JWT
# Use três valores aleatórios diferentes, cada um com ao menos 32 caracteres.
# Gere cada valor com: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET="substitua_por_uma_chave_aleatoria_forte_e_unica"
JWT_ACCESS_SECRET="substitua_por_outra_chave_aleatoria_forte_e_unica"
JWT_REFRESH_SECRET="substitua_por_uma_terceira_chave_aleatoria_forte_e_unica"

# Cookie domain (set to root domain in prod so frontend/backend share cookies)
# COOKIE_DOMAIN=.renannardi.com

# OpenAI
OPENAI_API_KEY="sk-sua_chave_openai_aqui"

# Firebase (optional)
FIREBASE_API_KEY=""
FIREBASE_AUTH_DOMAIN=""
FIREBASE_PROJECT_ID=""
FIREBASE_STORAGE_BUCKET=""
FIREBASE_MESSAGING_SENDER_ID=""
